# Copiar a apps/api/.env. No versionar el archivo con valores reales.
NODE_ENV=development
API_PORT=3000
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Para usar Try it out de Swagger local, agregar ,http://localhost:3000
# Los orígenes se autorizan de forma exacta; no usar asteriscos.

# Azure SQL. La cuenta tecnica debe pertenecer unicamente a tc_runtime.
# Para SQL Server local, sustituir el host por localhost (fuera de Docker)
# o host.docker.internal (desde Docker).
DB_SERVER=sql-techcare-solutions-2026.database.windows.net
DB_PORT=1433
DB_NAME=TechCareDB
DB_USER=app_techcare
DB_PASSWORD=
DB_ENCRYPT=true
# No omitir la validacion del certificado de Azure.
DB_TRUST_SERVER_CERTIFICATE=false
# Presupuestos por fase; mantenerlos coordinados con los limites del proxy.
# Conservar 60000 para desarrollo/reanudacion serverless hasta medir latencias.
DB_CONNECTION_TIMEOUT_MS=60000
DB_REQUEST_TIMEOUT_MS=60000

# Completar DB_PASSWORD solo en el .env privado o en el entorno de Render.

# Generar un secreto aleatorio de al menos 32 caracteres antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=1h
