# Copiar a apps/api/.env. No versionar el archivo con valores reales.
NODE_ENV=development
API_PORT=3000
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
# Para usar Try it out de Swagger local, agregar ,http://localhost:3000
# Los orígenes se autorizan de forma exacta; no usar asteriscos.

# SQL Server instalado en Windows: habilitar TCP/IP y usar su puerto TCP real.
# Dentro del contenedor, localhost es el propio contenedor.
# Con pnpm dev:api fuera de Docker usar DB_SERVER=localhost.
DB_SERVER=host.docker.internal
DB_PORT=1433
DB_NAME=TechCareDB
DB_USER=
DB_PASSWORD=
DB_ENCRYPT=true
# Solo local con certificado autofirmado; en Azure debe ser false.
DB_TRUST_SERVER_CERTIFICATE=true

# Azure pendiente: cambiar DB_SERVER a <servidor>.database.windows.net,
# configurar DB_NAME/DB_USER/DB_PASSWORD y mantener DB_ENCRYPT=true.
# Establecer DB_TRUST_SERVER_CERTIFICATE=false; sin cambios de codigo.

# Generar un secreto aleatorio de al menos 32 caracteres antes de iniciar.
JWT_SECRET=
JWT_EXPIRES_IN=1h
